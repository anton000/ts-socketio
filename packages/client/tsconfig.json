{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@ts-socketio/core": ["../core/src"] // Reference sibling workspace
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../core" } // Reference the core package for building
  ]
} 