{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@ts-socketio/core": ["../core/src"],
      "@ts-socketio/server": ["../server/src"]
    },
    /* NestJS specific options */
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "incremental": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"],
  "references": [
    { "path": "../core" },
    { "path": "../server" }
  ]
}
